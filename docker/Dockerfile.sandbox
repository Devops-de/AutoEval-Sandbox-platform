# Hardened Ephemeral Docker Sandbox Image
# Security Highlights:
# - Unprivileged non-root user (uid:gid 10001:10001)
# - No network tools installed
# - Minimalist Python 3.12 slim runtime
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /sandbox

# Create unprivileged sandbox user
RUN groupadd -g 10001 sandbox && \
    useradd -u 10001 -g sandbox -m -s /bin/false sandbox

# Install evaluation dependencies (pytest, numpy)
RUN pip install --no-cache-dir \
    pytest>=8.0.0 \
    numpy>=1.26.0

# Copy only the sandbox runner & profiler packages
COPY autoeval /sandbox/autoeval

# Secure file permissions (read-only application directory for sandbox user)
RUN chown -R root:root /sandbox && \
    chmod -R 755 /sandbox

# Switch to unprivileged non-root user
USER 10001:10001

CMD ["python", "-m", "autoeval.sandbox.runner_script"]
